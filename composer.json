{
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Support/helpers.php"
    ]
  },
  "require": {
    "php": ">=8.3",
    "php-webdriver/webdriver": "^1.15",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "ext-zip": "*",
    "simplehtmldom/simplehtmldom": "^2.0@RC",
    "monolog/monolog": "^3.5",
    "php-di/php-di": "^7.1"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.82",
    "kubawerlos/php-cs-fixer-custom-fixers": "^3.30"
  },
  "scripts": {
    "code:style:fix": "php-cs-fixer fix --diff --allow-risky=yes -vvv"
  }
}
