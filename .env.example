APP_NAME="RabotaBy Bot"
APP_URL=https://rabota.by
APP_DEBUG=true

ACCOUNT_COUNTRY=BY
ACCOUNT_PHONE=
ACCOUNT_PASSWORD=

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
