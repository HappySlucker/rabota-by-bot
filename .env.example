DB_PASSWORD=

SELENIUM_ENABLED=true
SELENIUM_PORT=4444
SELENIUM_DELAY_AFTER_RAISING_IN_S=5

WEBDRIVER_REQUEST_TIMEOUT_IN_MS=240000
WEBDRIVER_URL_LOADER_MAX_ATTEMPTS=3
WEBDRIVER_URL_LOADER_RETRY_DELAY_SECONDS=5
WEBDRIVER_URL_LOADER_WAIT_TIME_SECONDS=10
WEBDRIVER_WAIT_TIMEOUT_IN_SECONDS=5
WEBDRIVER_WAIT_INTERVAL_IN_MILLISECONDS=500

ENABLE_RESUME_UPDATER=true

